# docker compose için örnek ayarlar. Bu dosyayı .env olarak kopyalayıp değerleri değiştirin.
# .env dosyası git'e eklenmez.

# PostgreSQL parolası
POSTGRES_PASSWORD=buraya-guclu-bir-parola-yazin

# JWT imzalama anahtarı: en az 32 karakter, rastgele olmalı
# Üretmek için (PowerShell): [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_ANAHTAR=buraya-en-az-32-karakterlik-rastgele-bir-anahtar-yazin

# Uygulamanın yayınlanacağı port (http://localhost:8080)
WEB_PORT=8080
